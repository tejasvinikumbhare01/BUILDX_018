PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/resqgrid?schema=public"
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# Optional: Real OpenAI API key for LLM Emergency Assistant & Vision Damage Classification
OPENAI_API_KEY=""

# Optional: Weather API Key (Open-Meteo works without keys by default; set this for OpenWeatherMap if preferred)
WEATHER_API_KEY=""
WATER_LEVEL_API_KEY=""

# Python AI Microservice URL
AI_SERVICE_URL="http://localhost:8000"
